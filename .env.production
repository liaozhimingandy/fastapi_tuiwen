# ==============================================
# 生产环境配置（Docker/服务器）
# ==============================================

# 基础应用
TABLE_PREFIX=tw_
ACCOUNT_ID_PREFIX=twid_
DEBUG=False
SECRET_KEY=
SECRET_KEY_FILE=/run/secrets/secret_key.txt
TIME_ZONE=Asia/Shanghai

# 静态资源
STATIC_URL=https://tuiwen.alsoapp.com/static/
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,gif,bmp

# 跨域（只保留线上真实域名）
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173,https://tuiwen.alsoapp.com,https://api.tuiwen.alsoapp.com

# PostgreSQL（Docker 服务名）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tuiwen
POSTGRES_USER=postgres
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password.txt

# Redis（Docker 服务名）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD_FILE=/run/secrets/redis_password.txt
REDIS_EXPIRE=1800
REDIS_SOCKET_TIMEOUT=2

# 其它
TURNSTILE_SECRET_KEY_FILE=/run/secrets/turnstile_secret_key.txt

SNAP_SESSION_OPEN_HOUR=18
SNAP_SESSION_BURN_HOUR=7

VIDEO_MAX_BYTES=104857600
VIDEO_ALLOW_SUFFIX=mp4,mov,mkv